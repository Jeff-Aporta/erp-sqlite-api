{
  "tasks": {
    "dev": "deno run -A --watch src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write src/main.ts",
    "build:front": "deno run -A scripts/build-front.ts",
    "seed": "deno run -A scripts/seed-demo.ts",
    "check": "deno check src/main.ts scripts/",
    "test": "deno test -A tests/"
  },
  "imports": {
    "@Jeff-Aporta/DER": "https://cdn.jsdelivr.net/gh/Jeff-Aporta/DER@84326ccbbbb313720e4289e22ab9b9163bb8dc4b/mod.ts",
    "@Jeff-Aporta/DER/": "https://cdn.jsdelivr.net/gh/Jeff-Aporta/DER@84326ccbbbb313720e4289e22ab9b9163bb8dc4b/",
    "@Jeff-Aporta/dev-vps/": "https://cdn.jsdelivr.net/gh/Jeff-Aporta/dev-vps@57e0d043f3a64876558afda9c37ac472db849c65/",
    "zod": "npm:zod@4.6.7",
    "kysely": "npm:kysely@0.28.17"
  },
  "nodeModulesDir": "auto",
  "unstable": [
    "sloppy-imports"
  ]
}
