{
  "tasks": {
    "dev": "deno run -A --watch src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write src/main.ts",
    "build:front": "deno run -A scripts/build-front.ts",
    "seed": "deno run -A scripts/seed-demo.ts",
    "check": "deno check src/main.ts scripts/",
    "test": "deno test -A tests/"
  },
  "imports": {
    "@Jeff-Aporta/DER": "https://cdn.jsdelivr.net/gh/Jeff-Aporta/DER@ab4b4b2940006cc424934deeffd6cbf280a27bfc/mod.ts",
    "@Jeff-Aporta/DER/": "https://cdn.jsdelivr.net/gh/Jeff-Aporta/DER@ab4b4b2940006cc424934deeffd6cbf280a27bfc/",
    "@Jeff-Aporta/dev-vps/": "https://cdn.jsdelivr.net/gh/Jeff-Aporta/dev-vps@a0faf6e8b99fd5b5f3b15cff8119bc7c3578d6f3/",
    "zod": "npm:zod@4.6.7",
    "kysely": "npm:kysely@0.28.17"
  },
  "nodeModulesDir": "auto",
  "unstable": [
    "sloppy-imports"
  ]
}
