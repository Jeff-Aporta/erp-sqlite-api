# Copiar a .env (local) o /etc/erp-sqlite/api.env (VPS; lo genera deploy/install.sh).
# Sin JWT_SECRET (>=32), ADMIN_USER y ADMIN_PASSWORD (>=8) el server NO arranca.

# Firma de los JWT y pepper del hash de contraseñas: si cambia, todos los usuarios quedan inválidos.
JWT_SECRET=
# Admin sembrado en el primer arranque (si ya existe, no se toca).
ADMIN_USER=admin
ADMIN_PASSWORD=

PORT=8091
HOST=127.0.0.1
# Estado del API (usuarios, sesiones, auditoría). Default: ./data/admin.sqlite
DB=
# Carpeta de bases administradas (*.sqlite). Default: ./data/db
DB_DIR=
# 1 = mensajes internos en errores 500 (solo desarrollo).
EXPOSE_ERRORS=
